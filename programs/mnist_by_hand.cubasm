; MNIST by hand (Stage 5).
;
; Write the whole MNIST program yourself, one instruction per line, using the DRAM
; layout and scratchpad plan in docs/05-mnist-by-hand.md. The test assembles this
; file, drops the instructions into the compiled image in place of the compiler's
; own, and runs it on the simulator. If the logits match, you have written the same
; program the compiler will write in Stage 6.
;
; DRAM layout (from `python -m cub compile`):
;   w1      0x00400   INT8  (128 x 784) row-major
;   b1      0x18C00   INT32 x 128
;   w2      0x18E00   INT8  (10 x 128)
;   b2      0x19300   INT32 x 10
;   input   0x19340   INT8  x 784
;   output  0x19680   INT32 x 10
;
; Scratchpad plan:
;   SPAD_A: input at 0, hidden activations at 1024
;   SPAD_W: w1 at 0, w2 right after it
;   SPAD_B: b1 at 0, b2 right after it
;   ACC:    always at 0
;   layer-1 shift: 12

; ---- layer 1: 784 -> 128, ReLU ----
LOAD     mem=SPAD_A  dram=0x19340  spad=0  count=784
; --- SOLUTION(stage=5): load w1 and b1, MATMUL, ADD_BIAS, RELU into SPAD_A[1024] with shift 12 ---
LOAD     mem=SPAD_W  dram=0x400    spad=0  count=100352
LOAD     mem=SPAD_B  dram=0x18C00  spad=0  count=128
MATMUL   a=0  w=0  acc=0  n=128  k=784
ADD_BIAS acc=0  bias=0  count=128
RELU     acc=0  dst=1024  count=128  shift=12
; --- END SOLUTION ---

; ---- layer 2: 128 -> 10, logits ----
; --- SOLUTION(stage=5): load w2 and b2 after the layer-1 parameters, MATMUL from the hidden activations, ADD_BIAS, STORE the 10 INT32 logits to output ---
LOAD     mem=SPAD_W  dram=0x18E00  spad=100352  count=1280
LOAD     mem=SPAD_B  dram=0x19300  spad=128     count=10
MATMUL   a=1024  w=100352  acc=0  n=10  k=128
ADD_BIAS acc=0  bias=128  count=10
STORE    mem=ACC  dram=0x19680  spad=0  count=10
; --- END SOLUTION ---
HALT
